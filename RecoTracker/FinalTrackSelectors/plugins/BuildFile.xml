  <flags ALPAKA_BACKENDS="cuda"/>
  <flags ALPAKA_BACKENDS="serial"/>
  <!-- ROCm backend not yet supported, see: https://github.com/pytorch/pytorch/blob/main/aten/CMakeLists.txt#L75 -->
  <!-- <flags ALPAKA_BACKENDS="rocm"/> -->
  <flags EDM_PLUGIN="1"/>
  <flags remove="1">ofast-flag</flags>
